================================================== *\/\r\n\r\n.sap-capacitacion-efectiva__card p{\r\n    position:relative;\r\n    z-index:1;\r\n\r\n    margin:0 0 13px;\r\n\r\n    color:rgba(255,255,255,.82);\r\n\r\n    font-family:'Raleway', Arial, sans-serif;\r\n    font-size:14px;\r\n    line-height:1.75;\r\n    font-weight:400;\r\n}\r\n\r\n.sap-capacitacion-efectiva__card p:last-child{\r\n    margin-bottom:0;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   VARIACI\u00d3N DE TARJETAS\r\n   ========================================================= *\/\r\n\r\n.sap-capacitacion-efectiva__card:nth-child(2),\r\n.sap-capacitacion-efectiva__card:nth-child(3){\r\n    background:var(--sap-morado);\r\n}\r\n\r\n.sap-capacitacion-efectiva__card:nth-child(2)\r\n.sap-capacitacion-efectiva__number,\r\n.sap-capacitacion-efectiva__card:nth-child(3)\r\n.sap-capacitacion-efectiva__number{\r\n    background:var(--sap-azul);\r\n}\r\n\r\n.sap-capacitacion-efectiva__card:nth-child(2) h3::before,\r\n.sap-capacitacion-efectiva__card:nth-child(3) h3::before{\r\n    background:var(--sap-naranja);\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   TABLET\r\n   ========================================================= *\/\r\n\r\n@media(max-width:900px){\r\n\r\n    .sap-capacitacion-efectiva{\r\n        padding:50px 0;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__grid{\r\n        column-gap:20px;\r\n        row-gap:20px;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__card{\r\n        padding:28px 25px;\r\n    }\r\n\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   M\u00d3VIL\r\n   ========================================================= *\/\r\n\r\n@media(max-width:767px){\r\n\r\n    .sap-capacitacion-efectiva{\r\n        padding:40px 0;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__intro{\r\n        margin-bottom:30px;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__intro h2{\r\n        font-size:29px;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__intro p{\r\n        font-size:14px;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__grid{\r\n        grid-template-columns:1fr;\r\n        row-gap:18px;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__card{\r\n        min-height:auto;\r\n        padding:26px 23px;\r\n    }\r\n\r\n    .sap-capacitacion-efectiva__card h3{\r\n        font-size:19px;\r\n    }\r\n\r\n}\r\n\r\n<\/style>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-2d21c7c elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"2d21c7c\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-6c1298d\" data-id=\"6c1298d\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-548a7c4 elementor-widget elementor-widget-html\" data-id=\"548a7c4\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<!-- =========================================================\r\n     EMERSON RUSH \u00b7 MODALIDADES DE CAPACITACI\u00d3N\r\n     Pegar completo en un widget HTML de Elementor Pro\r\n     ========================================================= -->\r\n\r\n<section class=\"emr-modalidades\">\r\n\r\n    <header class=\"emr-modalidades__encabezado\">\r\n\r\n        <span class=\"emr-modalidades__etiqueta\">\r\n            FORMATOS DE APRENDIZAJE\r\n        <\/span>\r\n\r\n        <h2>\r\n            Modalidades de capacitaci\u00f3n\r\n            <span>disponibles<\/span>\r\n        <\/h2>\r\n\r\n        <p>\r\n            Cada organizaci\u00f3n puede elegir el modelo que mejor se adapte\r\n            a sus necesidades operativas.\r\n        <\/p>\r\n\r\n    <\/header>\r\n\r\n\r\n    <div class=\"emr-modalidades__lista\">\r\n\r\n\r\n        <!-- CAPACITACI\u00d3N PRESENCIAL -->\r\n        <article class=\"emr-modalidades__item\">\r\n\r\n            <div class=\"emr-modalidades__numero\">\r\n                <span>01<\/span>\r\n            <\/div>\r\n\r\n            <div class=\"emr-modalidades__contenido\">\r\n\r\n                <span class=\"emr-modalidades__tipo\">\r\n                    INTERACCI\u00d3N DIRECTA\r\n                <\/span>\r\n\r\n                <h3>Capacitaci\u00f3n presencial<\/h3>\r\n\r\n                <p>\r\n                    Ideal para proyectos de implementaci\u00f3n, talleres funcionales\r\n                    y sesiones donde la interacci\u00f3n directa favorece el aprendizaje.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n            <div class=\"emr-modalidades__detalle\"><\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- CAPACITACI\u00d3N VIRTUAL -->\r\n        <article class=\"emr-modalidades__item emr-modalidades__item--alterno\">\r\n\r\n            <div class=\"emr-modalidades__numero\">\r\n                <span>02<\/span>\r\n            <\/div>\r\n\r\n            <div class=\"emr-modalidades__contenido\">\r\n\r\n                <span class=\"emr-modalidades__tipo\">\r\n                    FLEXIBILIDAD Y ALCANCE\r\n                <\/span>\r\n\r\n                <h3>Capacitaci\u00f3n virtual<\/h3>\r\n\r\n                <p>\r\n                    Permite formar equipos ubicados en diferentes ciudades o pa\u00edses,\r\n                    manteniendo flexibilidad y reduciendo costos log\u00edsticos.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n            <div class=\"emr-modalidades__detalle\"><\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- MODELO H\u00cdBRIDO -->\r\n        <article class=\"emr-modalidades__item emr-modalidades__item--destacado\">\r\n\r\n            <div class=\"emr-modalidades__numero\">\r\n                <span>03<\/span>\r\n            <\/div>\r\n\r\n            <div class=\"emr-modalidades__contenido\">\r\n\r\n                <span class=\"emr-modalidades__tipo\">\r\n                    MODELO INTEGRAL\r\n                <\/span>\r\n\r\n                <h3>Modelo h\u00edbrido<\/h3>\r\n\r\n                <p>\r\n                    Actualmente representa una de las alternativas m\u00e1s eficientes,\r\n                    ya que combina sesiones pr\u00e1cticas presenciales con recursos\r\n                    digitales disponibles para consulta permanente.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n            <div class=\"emr-modalidades__detalle\"><\/div>\r\n\r\n        <\/article>\r\n\r\n    <\/div>\r\n\r\n<\/section>\r\n\r\n\r\n<style>\r\n\r\n\/* =========================================================\r\n   BASE\r\n   ========================================================= *\/\r\n\r\n.emr-modalidades{\r\n    --emr-negro:#111111;\r\n    --emr-morado:#5D3271;\r\n    --emr-blanco:#FFFFFF;\r\n    --emr-azul:#071C3B;\r\n    --emr-naranja:#CD5B56;\r\n    --emr-gris:#F3F3F3;\r\n    --emr-texto:#555555;\r\n\r\n    width:100%;\r\n    padding:65px 0;\r\n\r\n    font-family:Arial, Helvetica, sans-serif;\r\n    box-sizing:border-box;\r\n}\r\n\r\n.emr-modalidades *,\r\n.emr-modalidades *::before,\r\n.emr-modalidades *::after{\r\n    box-sizing:border-box;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   ENCABEZADO\r\n   ========================================================= *\/\r\n\r\n.emr-modalidades__encabezado{\r\n    max-width:760px;\r\n    margin:0 0 42px;\r\n}\r\n\r\n.emr-modalidades__etiqueta{\r\n    display:block;\r\n\r\n    margin-bottom:13px;\r\n\r\n    color:var(--emr-naranja);\r\n\r\n    font-size:12px;\r\n    line-height:1.2;\r\n    font-weight:700;\r\n    letter-spacing:
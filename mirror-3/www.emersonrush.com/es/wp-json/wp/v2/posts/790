  width:38px;\r\n    height:1px;\r\n\r\n    background:var(--er-naranja);\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   TEXTOS\r\n   ========================================================= *\/\r\n\r\n.er-beneficios-capacitacion__card h3{\r\n    margin:0 0 15px;\r\n\r\n    color:var(--er-azul);\r\n\r\n    font-size:20px;\r\n    line-height:1.3;\r\n    font-weight:700;\r\n}\r\n\r\n.er-beneficios-capacitacion__card p{\r\n    margin:0;\r\n\r\n    color:#555555;\r\n\r\n    font-size:14px;\r\n    line-height:1.75;\r\n    font-weight:400;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   TARJETA DESTACADA\r\n   ========================================================= *\/\r\n\r\n.er-beneficios-capacitacion__card--featured{\r\n    background:var(--er-azul);\r\n    border-top-color:var(--er-naranja);\r\n}\r\n\r\n.er-beneficios-capacitacion__card--featured h3{\r\n    color:var(--er-blanco);\r\n}\r\n\r\n.er-beneficios-capacitacion__card--featured p{\r\n    color:rgba(255,255,255,.78);\r\n}\r\n\r\n.er-beneficios-capacitacion__card--featured .er-beneficios-capacitacion__number{\r\n    color:var(--er-naranja);\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   HOVER\r\n   ========================================================= *\/\r\n\r\n.er-beneficios-capacitacion__card:hover{\r\n    transform:translateY(-5px);\r\n\r\n    box-shadow:\r\n        0 16px 35px rgba(7,28,59,.10);\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   TABLET\r\n   ========================================================= *\/\r\n\r\n@media(max-width:900px){\r\n\r\n    .er-beneficios-capacitacion{\r\n        padding:50px 0;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__grid{\r\n        grid-template-columns:repeat(2,1fr);\r\n    }\r\n\r\n    .er-beneficios-capacitacion__card,\r\n    .er-beneficios-capacitacion__card:nth-child(4),\r\n    .er-beneficios-capacitacion__card:nth-child(5){\r\n        grid-column:auto;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__card:last-child{\r\n        grid-column:1 \/ -1;\r\n    }\r\n\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   M\u00d3VIL\r\n   ========================================================= *\/\r\n\r\n@media(max-width:600px){\r\n\r\n    .er-beneficios-capacitacion{\r\n        padding:40px 0;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__header{\r\n        margin-bottom:30px;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__header h2{\r\n        font-size:29px;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__header p{\r\n        font-size:15px;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__grid{\r\n        grid-template-columns:1fr;\r\n        gap:14px;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__card,\r\n    .er-beneficios-capacitacion__card:nth-child(4),\r\n    .er-beneficios-capacitacion__card:nth-child(5),\r\n    .er-beneficios-capacitacion__card:last-child{\r\n        grid-column:auto;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__card{\r\n        min-height:auto;\r\n        padding:26px 24px;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__top{\r\n        margin-bottom:20px;\r\n    }\r\n\r\n    .er-beneficios-capacitacion__card h3{\r\n        font-size:19px;\r\n    }\r\n\r\n}\r\n\r\n<\/style>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-52bc164 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"52bc164\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-82e0e02\" data-id=\"82e0e02\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-118fccd elementor-widget elementor-widget-html\" data-id=\"118fccd\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<!-- =========================================================\r\n     EMERSON RUSH \u00b7 \u00bfQUI\u00c9NES DEBEN PARTICIPAR?\r\n     Dise\u00f1o tipo ruta \/ \u00e1reas\r\n     ========================================================= -->\r\n\r\n<section class=\"er-participantes\">\r\n\r\n    <!-- INTRODUCCI\u00d3N -->\r\n    <div class=\"er-participantes__intro\">\r\n\r\n        <div class=\"er-participantes__intro-content\">\r\n\r\n            <span class=\"er-participantes__eyebrow\">\r\n                CAPACITACI\u00d3N POR PERFIL\r\n            <\/span>\r\n\r\n            <h2>\r\n                \u00bfQui\u00e9nes deben participar en la\r\n                <span>capacitaci\u00f3n?<\/span>\r\n            <\/h2>\r\n\r\n            <p>\r\n                Uno de los errores m\u00e1s comunes consiste en impartir el mismo\r\n                contenido a todos los colaboradores.\r\n            <\/p>\r\n\r\n            <div class=\"er-participantes__mensaje\">\r\n                <span><\/span>\r\n                <p>\r\n                    Cada \u00e1rea utiliza SAP de manera distinta y requiere\r\n                    conocimientos espec\u00edficos.\r\n                <\/p>\r\n            <\/div>\r\n\r\n        <\/div>\r\n\r\n    <\/div>\r\n\r\n\r\n    <!-- =====================================================\r\n         \u00c1REAS\r\n         ===================================================== -->\r\n\r\n    <div class=\"er-participantes__areas\">\r\n\r\n\r\n        <!-- 01 \u00b7 DIRECCI\u00d3N -->\r\n        <article class=\"er-participantes__area\">\r\n\r\n            <div class=\"er-participantes__numero\">\r\n                01\r\n            <\/div>\r\n\r\n            <div class=\"er-participantes__contenido\">\r\n\r\n                <h3>Direcci\u00f3n y alta gerencia<\/h3>\r\n\r\n                <p>\r\n                    Los directivos necesitan comprender indicadores, tableros\r\n                    ejecutivos y herramientas de an\u00e1lisis que faciliten la toma\r\n                    de decisiones basada en datos.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- 02 \u00b7 FINANZAS -->\r\n        <article class=\"er-participantes__area\">\r\n\r\n            <div class=\"er-participantes__numero\">\r\n                02\r\n            <\/div>\r\n\r\n            <div class=\"er-participantes__contenido\">\r\n\r\n                <h3>Finanzas<\/h3>\r\n\r\n                <p>\r\n                    El equipo financiero debe dominar procesos relacionados con:\r\n                <\/p>\r\n\r\n                <div class=\"er-participantes__tags\">\r\n\r\n                    <span>Contabilidad general<\/span>\r\n                    <span>Activos fijos<\/span>\r\n                    <span>Tesorer\u00eda<\/span>\r\n                    <span>Cuentas por pagar<\/span>\r\n                    <span>Cuentas por cobrar<\/span>\r\n                    <span>Cierres financieros<\/span>\r\n\r\n                <\/div>\r\n\r\n            <\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- 03 \u00b7 COMPRAS -->\r\n        <article class=\"er-participantes__area\">\r\n\r\n            <div class=\"er-participantes__numero\">\r\n                03\r\n            <\/div>\r\n\r\n            <div class=\"er-participantes__contenido\">\r\n\r\n                <h3>Compras y abastecimiento<\/h3>\r\n\r\n                <p>\r\n                    Los responsables de adquisiciones requieren conocer procesos como:\r\n                <\/p>\r\n\r\n                <div class=\"er-participantes__tags\">\r\n\r\n                    <span>Solicitudes de compra<\/span>\r\n                    <span>\u00d3rdenes de compra<\/span>\r\n                    <span>Gesti\u00f3n de proveedores<\/span>\r\n                    <span>Recepci\u00f3n de materiales<\/span>\r\n                    <span>Evaluaci\u00f3n del abastecimiento<\/span>\r\n\r\n                <\/div>\r\n\r\n            <\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- 04 \u00b7 PRODUCCI\u00d3N -->\r\n        <article class=\"er-participantes__area\">\r\n\r\n            <div class=\"er-participantes__numero\">\r\n                04\r\n            <\/div>\r\n\r\n            <div class=\"er-participantes__contenido\">\r\n\r\n                <h3>Producci\u00f3n<\/h3>\r\n\r\n                <p>\r\n                    En empresas manufactureras resulta indispensable comprender\r\n                    la planeaci\u00f3n de producci\u00f3n, listas de materiales, centros de\r\n                    trabajo, costos y control de \u00f3rdenes productivas.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- 05 \u00b7 LOG\u00cdSTICA -->\r\n        <article class=\"er-participantes__area\">\r\n\r\n            <div class=\"er-participantes__numero\">\r\n                05\r\n            <\/div>\r\n\r\n            <div class=\"er-participantes__contenido\">\r\n\r\n                <h3>Log\u00edstica y almacenes<\/h3>\r\n\r\n                <p>\r\n                    Las \u00e1reas log\u00edsticas deben dominar procesos relacionados con\r\n                    inventarios, embarques, entregas, almacenamiento y distribuci\u00f3n.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n        <\/article>\r\n\r\n    <\/div>\r\n\r\n\r\n    <!-- =====================================================\r\n         CIERRE\r\n         ===================================================== -->\r\n\r\n    <div class=\"er-participantes__cierre\">\r\n\r\n        <div class=\"er-participantes__cierre-numero\">\r\n            5\r\n            <small>\u00c1REAS<\/small>\r\n        <\/div>\r\n\r\n        <div class=\"er-participantes__cierre-texto\">\r\n\r\n            <span>UNA CAPACITACI\u00d3N, DISTINTAS NECESIDADES<\/span>\r\n\r\n            <p>\r\n                Cada programa debe dise\u00f1arse considerando las responsabilidades\r\n                reales de los participantes y los procesos espec\u00edficos de la empresa.\r\n            <\/p>\r\n\r\n        <\/div>\r\n\r\n    <\/div>\r\n\r\n<\/section>\r\n\r\n\r\n<style>\r\n\r\n\/* =========================================================\r\n   BASE\r\n   ========================================================= *\/\r\n\r\n.er-participantes{\r\n    --morado:#5D3271;\r\n    --azul:#071C3B;\r\n    --naranja:#CD5B56;\r\n    --gris:#F3F3F3;\r\n    --negro:#111111;\r\n    --blanco:#FFFFFF;\r\n\r\n    width:100%;\r\n    padding:65px 0;\r\n\r\n    font-family:Arial, Helvetica, sans-serif;\r\n    box-sizing:border-box;\r\n}\r\n\r\n.er-participantes *,\r\n.er-participantes *::before,\r\n.er-participantes *::after{\r\n    box-sizing:border-box;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   INTRODUCCI\u00d3N\r\n   ========================================================= *\/\r\n\r\n.er-participantes__intro{\r\n    display:grid;\r\n    grid-template-columns:1fr;\r\n    margin-bottom:48px;\r\n}\r\n\r\n.er-participantes__intro-content{\r\n    max-width:800px;\r\n}\r\n\r\n.er-participantes__eyebrow{\r\n    display:block;\r\n\r\n    margin-bottom:13px;\r\n\r\n    color:var(--naranja);\r\n\r\n    font-size:12px;\r\n    line-height:1.2;\r\n    font-weight:700;\r\n    letter-spacing:2px;\r\n}\r\n\r\n.er-participantes__intro h2{\r\n    max-width:750px;\r\n\r\n    margin:0 0 20px;\r\n\r\n    color:var(--azul);\r\n\r\n    font-size:38px;\r\n    line-height:1.15;\r\n    font-weight:700;\r\n}\r\n\r\n.er-participantes__intro h2 span{\r\n    color:var(--morado);\r\n}\r\n\r\n.er-participantes__intro > div > p{\r\n    max-width:670px;\r\n\r\n    margin:0 0 25px;\r\n\r\n    color:#555555;\r\n\r\
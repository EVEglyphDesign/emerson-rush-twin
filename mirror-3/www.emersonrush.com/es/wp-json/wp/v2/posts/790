idades__item--destacado h3{\r\n    color:var(--emr-blanco);\r\n}\r\n\r\n.emr-modalidades__item--destacado p{\r\n    color:rgba(255,255,255,.78);\r\n}\r\n\r\n.emr-modalidades__item--destacado .emr-modalidades__detalle{\r\n    background:var(--emr-morado);\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   TABLET\r\n   ========================================================= *\/\r\n\r\n@media(max-width:800px){\r\n\r\n    .emr-modalidades{\r\n        padding:50px 0;\r\n    }\r\n\r\n    .emr-modalidades__item{\r\n        grid-template-columns:100px 1fr 10px;\r\n    }\r\n\r\n    .emr-modalidades__contenido{\r\n        padding:28px 30px;\r\n    }\r\n\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   M\u00d3VIL\r\n   ========================================================= *\/\r\n\r\n@media(max-width:600px){\r\n\r\n    .emr-modalidades{\r\n        padding:40px 0;\r\n    }\r\n\r\n    .emr-modalidades__encabezado{\r\n        margin-bottom:30px;\r\n    }\r\n\r\n    .emr-modalidades__encabezado h2{\r\n        font-size:29px;\r\n    }\r\n\r\n    .emr-modalidades__encabezado p{\r\n        font-size:15px;\r\n    }\r\n\r\n    .emr-modalidades__item{\r\n        grid-template-columns:1fr;\r\n        min-height:auto;\r\n    }\r\n\r\n    .emr-modalidades__item:hover{\r\n        transform:translateY(-4px);\r\n    }\r\n\r\n    .emr-modalidades__numero{\r\n        justify-content:flex-start;\r\n\r\n        min-height:58px;\r\n        padding:0 22px;\r\n    }\r\n\r\n    .emr-modalidades__numero span{\r\n        font-size:25px;\r\n    }\r\n\r\n    .emr-modalidades__contenido{\r\n        padding:25px 22px 28px;\r\n    }\r\n\r\n    .emr-modalidades__contenido h3{\r\n        font-size:19px;\r\n    }\r\n\r\n    .emr-modalidades__detalle{\r\n        width:100%;\r\n        height:7px;\r\n    }\r\n\r\n}\r\n\r\n<\/style>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-29c9134 elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"29c9134\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-wide\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-2334e09\" data-id=\"2334e09\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-129f291 elementor-widget elementor-widget-text-editor\" data-id=\"129f291\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h2 style=\"text-align: left;\"><b>\u00bfC\u00f3mo elegir un proveedor de capacitaci\u00f3n SAP?<\/b><\/h2>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-805358a\" data-id=\"805358a\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-dcc12f6 elementor-widget elementor-widget-text-editor\" data-id=\"dcc12f6\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Seleccionar un programa de formaci\u00f3n implica mucho m\u00e1s que revisar el temario.<\/span><\/p><p><span style=\"font-weight: 400;\">Es recomendable evaluar aspectos como:<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Experiencia comprobada en proyectos SAP.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Conocimiento del sector donde opera la empresa.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Capacidad para adaptar el contenido a procesos espec\u00edficos.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Actualizaci\u00f3n permanente sobre nuevas versiones de SAP S\/4HANA.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Metodolog\u00edas pr\u00e1cticas basadas en escenarios reales.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Acompa\u00f1amiento posterior al entrenamiento.<\/span><\/li><\/ul><p><span style=\"font-weight: 400;\">Un proveedor especializado comprender\u00e1 que cada organizaci\u00f3n enfrenta retos distintos y ajustar\u00e1 el contenido para responder a sus objetivos de negocio.<\/span><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-e531595 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"e531595\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-05e39ab\" data-id=\"05e39ab\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-89ce93e elementor-widget elementor-widget-image\" data-id=\"89ce93e\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"787\" height=\"527\" src=\"https:\/\/www.emersonru
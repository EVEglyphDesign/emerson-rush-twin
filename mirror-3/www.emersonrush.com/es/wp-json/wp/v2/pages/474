entor-element-9b1fd67 elementor-widget elementor-widget-html\" data-id=\"9b1fd67\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Raleway:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\r\n\r\n<style>\r\n  .sap-outsourcing-columns {\r\n    font-family: 'Raleway', sans-serif;\r\n    color: #000000;\r\n    max-width: 1100px;\r\n    margin: 0 auto;\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 35px;\r\n  }\r\n\r\n  .sap-out-column {\r\n    padding: 10px 25px 10px 0;\r\n    border-right: 3px solid #AE2661;\r\n  }\r\n\r\n  .sap-out-column:last-child {\r\n    border-right: none;\r\n    padding-right: 0;\r\n  }\r\n\r\n  .sap-out-column h2 {\r\n    font-size: 1.65em;\r\n    font-weight: 800;\r\n    line-height: 1.15;\r\n    color: #23293E;\r\n    margin: 0 0 22px;\r\n    padding-left: 14px;\r\n    border-left: 6px solid #AE2661;\r\n  }\r\n\r\n  .sap-out-item {\r\n    margin-bottom: 22px;\r\n  }\r\n\r\n  .sap-out-item:last-child {\r\n    margin-bottom: 0;\r\n  }\r\n\r\n  .sap-out-item h3 {\r\n    font-size: 1.15em;\r\n    font-weight: 700;\r\n    color: #000000;\r\n    margin: 0 0 6px;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n  }\r\n\r\n  .sap-out-icon {\r\n    width: 34px;\r\n    height: 34px;\r\n    min-width: 34px;\r\n    border-radius: 50%;\r\n    background: #23293E;\r\n    color: #FFFFFF;\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    font-size: 0.85em;\r\n    font-weight: 800;\r\n    box-shadow: 0 0 0 4px rgba(174, 38, 97, 0.15);\r\n  }\r\n\r\n  .sap-out-item p {\r\n    font-size: 0.98em;\r\n    line-height: 1.35;\r\n    margin: 0;\r\n    color: #000000;\r\n  }\r\n\r\n  .sap-out-list {\r\n    list-style: none;\r\n    padding: 0;\r\n    margin: 0;\r\n  }\r\n\r\n  .sap-out-list li {\r\n    position: relative;\r\n    padd
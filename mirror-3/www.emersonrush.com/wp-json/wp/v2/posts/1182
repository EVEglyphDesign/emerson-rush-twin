ation<\/strong><\/h3>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-2af8082 elementor-reverse-mobile elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"2af8082\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-d1b60cc\" data-id=\"d1b60cc\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-c3eabd2 elementor-widget elementor-widget-image\" data-id=\"c3eabd2\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"515\" height=\"239\" src=\"https:\/\/www.emersonrush.com\/wp-content\/uploads\/2021\/01\/supply-chain-management-canada-report-generation.jpg\" class=\"attachment-large size-large wp-image-1194\" alt=\"supply chain management Canada\" srcset=\"https:\/\/www.emersonrush.com\/wp-content\/uploads\/2021\/01\/supply-chain-management-canada-report-generation.jpg 515w, https:\/\/www.emersonrush.com\/wp-content\/uploads\/2021\/01\/supply-chain-management-canada-report-generation-300x139.jpg 300w\" sizes=\"(max-width: 515px) 100vw, 515px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-309d5bf\" data-id=\"309d5bf\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-84523f3 elementor-widget elementor-widg
: 16px; \r\n      font-weight: 700;\r\n      margin: 1.5em 0 0.5em 0;\r\n      position: relative;\r\n      padding-left: 20px; \/* Espacio para el bullet *\/\r\n    }\r\n\r\n    \/* Creaci\u00f3n del bullet para el H3 *\/\r\n    .sap-247 h3::before {\r\n      content: \"\";\r\n      background-color: #EE5781; \/* Magenta *\/\r\n      width: 8px;\r\n      height: 8px;\r\n      border-radius: 50%;\r\n      position: absolute;\r\n      left: 2px;\r\n      top: 0.5em; \/* Alineaci\u00f3n vertical *\/\r\n    }\r\n  <\/style>\r\n\r\n  <h3>Garantiza la continuidad operativa<\/h3>\r\n  <p>Los sistemas SAP suelen ser el n\u00facleo de las operaciones empresariales. Un problema no resuelto puede afectar m\u00faltiples \u00e1reas simult\u00e1neamente.<\/p>\r\n\r\n  <h3>Reduce tiempos de inactividad<\/h3>\r\n  <p>Contar con especialistas permite atender incidencias con rapidez y minimizar el impacto sobre la operaci\u00f3n.<\/p>\r\n\r\n  <h3>Incrementa la productividad<\/h3>\r\n  <p>Los usuarios pueden enfocarse en sus responsabilidades sin interrupciones prolongadas derivadas de fallas tecnol\u00f3gicas.<\/p>\r\n\r\n  <h3>Protege la inversi\u00f3n en SAP<\/h3>\r\n  <p>El soporte adecuado contribuye a maximizar el retorno de inversi\u00f3n de la plataforma.<\/p>\r\n\r\n<\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-af05dc0 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"af05dc0\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-a1c9e19\" data-id=\"a1
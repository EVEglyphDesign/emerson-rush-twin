class=\"emr-crecimiento-pyme__detalle\"><\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- ITEM 02 -->\r\n        <article class=\"emr-crecimiento-pyme__item emr-crecimiento-pyme__item--alterno\">\r\n\r\n            <div class=\"emr-crecimiento-pyme__numero\">\r\n                <span>02<\/span>\r\n            <\/div>\r\n\r\n            <div class=\"emr-crecimiento-pyme__contenido\">\r\n\r\n                <span class=\"emr-crecimiento-pyme__tipo\">\r\n                    CONSULTOR\u00cdA ESPECIALIZADA\r\n                <\/span>\r\n\r\n                <h3>Evoluci\u00f3n a la par<\/h3>\r\n\r\n                <p>\r\n                    Trabajar con un consultor especializado permite que SAP evolucione al mismo ritmo que la organizaci\u00f3n.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n            <div class=\"emr-crecimiento-pyme__detalle\"><\/div>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- ITEM 03 \u00b7 DESTACADO -->\r\n        <article class=\"emr-crecimiento-pyme__item emr-crecimiento-pyme__item--destacado\">\r\n\r\n            <div class=\"emr-crecimiento-pyme__numero\">\r\n                <span>03<\/span>\r\n            <\/div>\r\n\r\n            <div class=\"emr-crecimiento-pyme__contenido\">\r\n\r\n                <span class=\"emr-crecimiento-pyme__tipo\">\r\n                    PLANEACI\u00d3N ESTRAT\u00c9GICA\r\n                <\/span>\r\n\r\n                <h3>Estrategia proactiva<\/h3>\r\n\r\n                <p>\r\n                    En lugar de realizar cambios reactivos, la empresa puede planificar mejoras tecnol\u00f3gicas que acompa\u00f1en su estrategia de crecimiento y preparen la plataforma para nuevos desaf\u00edos.\r\n                <\/p>\r\n\r\n            <\/div>\r\n\r\n            <div class=\"emr-crecimiento-pyme__detalle\"><\/div>\r\n\r\n        <\/article>\r\n\r\n    <\/div>\r\n\r\n<\/section>\r\n\r\n\r\n<style>\r\n\r\n\/* =========================================================\r\n   BASE (CLASES AISLAD
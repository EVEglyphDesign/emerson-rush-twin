      content: \"\";\r\n      background-color: #EE5781; \/* Magenta *\/\r\n      width: 8px;\r\n      height: 8px;\r\n      border-radius: 50%;\r\n      position: absolute;\r\n      left: 2px;\r\n      top: 0.5em; \/* Alineaci\u00f3n vertical *\/\r\n    }\r\n  <\/style>\r\n\r\n  <h3>Mantenimiento preventivo<\/h3>\r\n  <p>Busca evitar la aparici\u00f3n de problemas mediante revisiones peri\u00f3dicas y monitoreo continuo.<\/p>\r\n\r\n  <h3>Mantenimiento correctivo<\/h3>\r\n  <p>Se enfoca en resolver incidencias una vez que han ocurrido.<\/p>\r\n\r\n  <h3>Mantenimiento evolutivo<\/h3>\r\n  <p>Permite incorporar mejoras y adaptaciones conforme evolucionan los requerimientos empresariales.<\/p>\r\n\r\n  <h3>Mantenimiento predictivo<\/h3>\r\n  <p>Utiliza informaci\u00f3n hist\u00f3rica y herramientas de an\u00e1lisis para anticipar posibles fallas.<\/p>\r\n\r\n<\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-13aaf74\" data-id=\"13aaf74\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-aca529c elementor-widget elementor-widget-image\" data-id=\"aca529c\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"800\" height=\"430\" src=\"https:\/\/www.emersonrush.com\/es\/wp-content\/uploads\/2026\/07\/Mantenimiento-SAP-mantenimiento.jpg\" class=\"attachment-large size-large wp-image-697\" alt=\"Mantenimiento SAP\" srcset=\"https:\/\/www.emersonrush.com\/es\/wp-content\/uploads\/2026\/07\/Mantenimiento-SAP-mantenimiento.jpg 969w, https:\/\/www.emersonrush.com\/es\/wp-content\/uploads\/2026\/07\/Mantenimiento-SAP-mantenimiento-300x161.jpg 300w, https:\/\/www.emersonrush.com\/es\/wp-content\/uploads\/2026\/07\/Mantenimiento-SAP-mantenimiento-768x413.jpg 768w\" sizes=\"(max-width: 800px) 100vw, 800px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-a663044 elementor-section-full_width elementor-section-content-bottom elementor-section-height-default elementor-section-height-default\" data-id=\"a663044\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-adf42e5\" data-id=\"adf42e5\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-145a762 elementor-widget elementor-widget-html\" data-id=\"145a762\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Raleway:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\r\n<style>\r\n  .sap-grid-container {\r\n    font-family: 'Raleway', sans-serif;\r\n    font-size: 1em;\r\n    color: #FFFFFF;\r\n    line-height: 1.25; \/* Interlineado bien compacto *\/\r\n    \r\n    \/* Configuraci\u00f3n de la rejilla: 2 columnas *\/\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    column-gap: 30px; \/* Espacio horizontal entre las tarjetas *\/\r\n    row-gap: 30px;    \/* Espacio vertical entre las tarjetas *\/\r\n  }\r\n\r\n  \/* Estilos para cada tarjeta contenedora *\/\r\n  .sap-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    border: 2px solid #FFFFFF; \/* Borde blanco de 2px *\/\r\n    border-radius: 18px;       \
solid #65377E;\r\n    padding-left: 18px;\r\n  }\r\n  .sap-247 .sap-lead {\r\n    font-weight: 700;\r\n    color: #071C3B;\r\n  }\r\n  .sap-247 ul {\r\n    margin: 1em 0 0 0;\r\n    padding-left: 1.2em;\r\n    list-style: none;\r\n  }\r\n  .sap-247 ul li {\r\n    color: #000000;\r\n    font-weight: 600;\r\n    margin-bottom: 0.6em;\r\n    padding-left: 24px;\r\n    position: relative;\r\n  }\r\n  .sap-247 ul li::before {\r\n    content: \"\";\r\n    background-color: #EE5781;\r\n    width: 8px;\r\n    height: 8px;\r\n    border-radius: 50%;\r\n    position: absolute;\r\n    left: 2px;\r\n    top: 0.4em;\r\n  }\r\n<\/style>\r\n\r\n<div class=\"sap-247\">\r\n\r\n  <div class=\"sap-intro\">\r\n    <p class=\"sap-lead\">El soporte SAP 24\/7 es un servicio especializado que proporciona asistencia t\u00e9cnica y funcional continua para garantizar el correcto funcionamiento de los sistemas SAP de una empresa.<\/p>\r\n  <\/div>\r\n\r\n  <p>A diferencia de los modelos tradicionales con horarios limitados, este servicio opera de manera ininterrumpida, permitiendo que cualquier incidente sea atendido de forma oportuna, independientemente del momento en que ocurra.<\/p>\r\n\r\n  <p>El objetivo principal es mantener la disponibilidad, estabilidad y rendimiento del ecosistema SAP para asegurar que los procesos cr\u00edticos del negocio contin\u00faen ejecut\u00e1ndose sin interrupciones.<\/p>\r\n\r\n  <p>Dependiendo de las necesidades de cada organizaci\u00f3n, el soporte SAP 24\/7 puede incluir:<\/p>\r\n\r\n  <ul>\r\n    <li>Soporte funcional SAP.<\/li>\r\n    <li>Soporte t\u00e9cnico SAP BASIS.<\/li>\r\n    <li>Monitoreo continuo.<\/li>\r\n    <li>Administraci\u00f3n de usuarios y autorizaciones.<\/li>\r\n    <li>Gesti\u00f3n de incidentes y problemas.<\/li>\r\n    <li>Aplicaci\u00f3n de mejoras y cambios.<\/li>\r\n    <li>Soporte para SAP S\/4HANA.<\/li>\r\n    <li>Servicios AMS (Application Management Services).<\/li>\r\n  <\/ul>\r\n\r\n<\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-a7ba0e4\" data-id=\"a7ba0e4\" data-element_type=\"column\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-970ea48 elementor-widget elementor-widget-spacer\" data-id=\"970ea48\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-03af47c elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"03af47c\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-f3abef1\" data-id=\"f3abef1\" data-element_type=\"column\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-b221b17 elementor-widget elementor-widget-spacer\" data-id=\"b221b17\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-7489154\" data-id=\"7489154\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-ba3389c elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"ba3389c\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-dc0c4f2\" data-id=\"dc0c4f2\" data-element_type=\"column\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-994f98b elementor-widget elementor-widget-text-editor\" data-id=\"994f98b\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h2><b>\u00bfPor qu\u00e9 es importante contar con soporte SAP las 24 horas?<\/b><\/h2>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c9869f5 elementor-widget elementor-widget-html\" data-id=\"c9869f5\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"sap-247\">\r\n  <style>\r\n    \/* Estilos base del contenedor *\/\r\n    .sap-247 {\r\n      font-size: 14px;\r\n      color: #000000;\r\n      line-height: 1.5;\r\n      max-width: 800px;\r\n      margin: 0 auto;\r\n    }\r\n    \r\n    .sap-247 p {\r\n      color: #000000;\r\n      margin: 0 0 1em 0;\r\n    }\r\n\r\n    \/* Estilos para los H3 con bullet magenta incorporado *\/\r\n    .sap-247 h3 {\r\n      color: #071C3B; \/* Azul profundo *\/\r\n      font-size: 16px; \r\n      font-weight: 700;\r\n      margin: 1.5em 0 0.5em 0;\r\n      position: relative;\r\n      padding-left: 20px; \/* Espacio para el bullet *\/\r\n    }\r\n\r\n    \/* Creaci\u00f3n del bullet para el H3 *\/\r\n    .sap-247 h3::before {\r\n      content: \"\";\r\n      background-color: #EE5781; \/* Magenta *\/\r\n      width: 8px;\r\n      height: 8px;\r\n      border-radius: 50%;\r\n      position: absolute;\r\n      left: 2px;\r\n      top: 0.5em; \/* Alineaci\u00f3n vertical relativa al tama\u00f1o del H3 *\/\r\n    }\r\n  <\/style>\r\n\r\n  <h3>Minimiza el tiempo de inactividad<\/h3>\r\n  <p>Las interrupciones en SAP pueden impactar m\u00faltiples \u00e1reas del negocio simult\u00e1neamente. Contar con especialistas disponibles en todo momento permite reducir significativamente los tiempos de respuesta y recuperaci\u00f3n.<\/p>\r\n\r\n  <h3>Garantiza la continuidad operativa<\/h3>\r\n  <p>Muchas organizaciones operan durante las 24 horas o tienen presencia en diferentes zonas geogr\u00e1ficas. El soporte continuo asegura que la operaci\u00f3n pueda mantenerse estable sin depender de horarios laborales tradicionales.<\/p>\r\n\r\n  <h3>Reduce riesgos empresariales<\/h3>\r\n  <p>Los incidentes en SAP pueden afectar procesos sensibles relacionados con finanzas, producci\u00f3n, log\u00edstica o recursos humanos. La atenci\u00f3n inmediata ayuda a contener el impacto antes de que escale.<\/p>\r\n\r\n  <h3>Mejora la experiencia del usuario<\/h3>\r\n  <p>Cuando los colaboradores cuentan con sistemas estables y soporte eficiente, pueden desempe\u00f1ar sus funciones con mayor productividad y confianza.<\/p>\r\n\r\n  <h3>Protege la inversi\u00f3n tecnol\u00f3gica<\/h3>\r\n  <p>SAP representa una inversi\u00f3n estrat\u00e9gica. Un soporte adecuado ayuda a maximizar su rendimiento y prolongar el valor obtenido a partir de su implementaci\u00f3n.<\/p>\r\n\r\n<\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-d519592 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"d519592\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-f708955\" data-id=\"f708955\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-52c000f elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"52c000f\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-30a25d8\" data-id=\"30a25d8\" data-element_type=\"column\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-a661537 elementor-widget elementor-widget-text-editor\" data-id=\"a661537\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h2><b>Consecuencias de no contar con soporte SAP 24\/7<\/b><\/h2>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-78f3114 elementor-widget elementor-widget-html\" data-id=\"78f3114\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"sap-247\">\r\n  <style>\r\n    \/* Estilos base del contenedor *\/\r\n    .sap-247 {\r\n      font-size: 14px;\r\n      color: #000000;\r\n      line-height: 1.5;\r\n      max-width: 800px;\r\n      margin: 0 auto;\r\n    }\r\n    \r\n    .sap-247 p {\r\n      color: #000000;\r\n      margin: 0 0 1em 0;\r\n    }\r\n\r\n    \/* Lista personalizada aislada con bullets magenta *\/\r\n    .sap-247 ul {\r\n      margin: 1em 0 1em 0;\r\n      padding-left: 0 !important;\r\n      list-style: none !important;\r\n    }\r\n\r\n    .sap-247 ul li {\r\n      color: #000000;\r\n      font-weight: 600;\r\n      margin-bottom: 0.6em;\r\n      padding-left: 24px;\r\n      position: relative;\r\n      list-style-type: none !important;\r\n    }\r\n\r\n    \/* Creaci\u00f3n del bullet circular para la lista *\/\r\n    .sap-247 ul li::before {\r\n      content: \"\";\r\n      background-color: #EE5781; \/* Magenta *\/\r\n      width: 8px;\r\n      height: 8px;\r\n      border-radius: 50%;\r\n      position: absolute;\r\n      left: 2px;\r\n      top: 0.4em;\r\n    }\r\n  <\/style>\r\n\r\n  <p>No disponer de un esquema de soporte continuo puede generar importantes desaf\u00edos operativos. Entre las consecuencias m\u00e1s comunes se encuentran:<\/p>\r\n\r\n  <ul>\r\n    <li>Incremento en los tiempos de inactividad.<\/li>\r\n    <li>Retrasos en procesos cr\u00edticos.<\/li>\r\n    <li>Insatisfacci\u00f3n de usuarios internos.<\/li>\r\n    <li>P\u00e9rdida de productividad.<\/li>\r\n    <li>Riesgos asociados al cumplimiento normativo.<\/li>\r\n    <li>Incremento de costos derivados de incidentes no resueltos oportunamente.<\/li>\r\n    <li>Sobrecarga de los equipos internos de TI.<\/li>\r\n  <\/ul>\r\n\r\n  <p>En organizaciones que operan con altos niveles de complejidad, estos riesgos pueden tener repercusiones financieras y reputacionales significativas.<\/p>\r\n\r\n<\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-d95a25d\" data-id=\"d95a25d\" data-element_type=\"column\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-2968425 elementor-widget elementor-widget-spacer\" data-id=\"2968425\" data-element_type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-7aa4aa2 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"7aa4aa2\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-extended\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-72da68f\" data-id=\"72da68f\" data-element_type=\"column\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6f7ab0e elementor-widget elementor-widget-text-editor\" data-id=\"6f7ab0e\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h2><b>\u00bfQu\u00e9 servicios debe incluir un soporte SAP 24\/7?<\/b><\/h2>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-061fa82 elementor-widget elementor-widget-html\" data-id=\"061fa82\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Raleway:wght@400;600;700;800&display=swap\" rel=\"stylesheet\">\r\n<style>\r\n  .sap-grid-container-dark {\r\n    font-family: 'Raleway', sans-serif;\r\n    font-size: 1em;\r\n    color: #000000;\r\n    line-height: 1.25; \/* Interlineado compacto *\/\r\n    max-width: 1000px;\r\n    margin: 0 auto;\r\n    \r\n    \/* Configuraci\u00f3n de la rejilla a 2 columnas *\/\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    column-gap: 25px;\r\n    row-gap: 25px;\r\n  }\r\n\r\n  \/* T\u00edtulo principal (si se llega a usar, ocupa las dos columnas) *\/\r\n  .sap-grid-container-dark h2 {\r\n    grid-column: span 2;\r\n    font-family: 'Raleway', sans-serif;\r\n    font-weight: 800;\r\n    font-size: 1.9em;\r\n    color: #000000;\r\n    margin-top: 0;\r\n    margin-bottom: 0.2em;\r\n  }\r\n\r\n  \/* Tarjeta contenedora con borde morado para cada secci\u00f3n *\/\r\n  .sap-section-dark {\r\n    display: flex;\r\n    flex-direction: column;\r\n    border: 2px solid #23293E; \/* Borde morado de 2px *\/\r\n    border-radius: 14px;        \/* Esquinas redondeadas *\/\r\n    padding: 20px;              \/* Padding para que no se amontone *\/\r\n    box-sizing: border-box;\r\n    background-color: transparent;\r\n  }\r\n\r\n  \/* Subt\u00edtulos sin bullets ni adornos *\/\r\n  .sap-grid-container-dark h3 {\r\n    font-family: 'Raleway', sans-serif;\r\n    font-weight: 700;\r\n    font-size: 1.3em;\r\n    color: #000000;\r\n    margin-top: 0; \/* Ajustado a 0 porque la tarjeta ya tiene padding *\/\r\n    margin-bottom: 0.4em;\r\n  }\r\n\r\n  .sap-grid-container-dark p {\r\n    color: #000000;\r\n    margin: 0.3em 0 0.8em 0;\r\n  }\r\n\r\n  \/* Evita m\u00e1rgenes dobles al final de la tarjeta *\/\r\n  .sap-grid-container-dark p:last-child, \r\n  .sap-grid-container-dark ul:last-child {\r\n    margin-bottom: 0;\r\n  }\r\n\r\n  .sap-grid-container-dark ul {\r\n    margin: 0.3em 0 1em 0;\r\n    padding-left: 0;\r\n    list-style: none;\r\n  }\r\n\r\n  \/* Bullets cambiados a c\u00edrculos *\/\r\n  .sap-grid-container-dark ul li {\r\n    color: #000000;\r\n    margin-bottom: 0.35em;\r\n    padding-left: 18px;\r\n    position: relative;\r\n  }\r\n\r\n  .sap-grid-container-dark ul li::before {\r\n    content: \"\u2022\"; \/* Vi\u00f1eta de c\u00edrculo est\u00e1ndar *\/\r\n    color: #AE2661;\r\n    font-weight: 700;\r\n    font-size: 1.2em;\r\n    position: absolute;\r\n    left: 0;\r\n    top: -0.1em;\r\n  }\r\n\r\n  .sap-grid-container-dark strong {\r\n    color: #000000;\r\n    font-weight: 700;\r\n  }\r\n\r\n  \/* Adaptaci\u00f3n para pantallas m\u00f3viles *\/\r\n  @media (max-width: 768px) {\r\n    .sap-grid-container-dark {\r\n      grid-template-columns: 1fr;\r\n      row-gap: 20px;\r\n    }\r\n    .sap-grid-container-dark h2 {\r\n      grid-column: span 1;\r\n    }\r\n    .sap-section-dark {\r\n      grid-column: span 1 !important; \/* Fuerza una columna en m\u00f3viles *\/\r\n    }\r\n  }\r\n<\/style>\r\n\r\n<div class=\"sap-grid-container-dark\">\r\n\r\n  <!-- 1. Mesa de ayuda especializada -->\r\n  <div class=\"sap-section-dark\">\r\n    <h3>Mesa de ayuda especializada<\/h3>\r\n    <p>Una mesa de ayuda centralizada permite registrar, clasificar y dar seguimiento a cada solicitud o incidente, estableciendo prioridades y mecanismos de escalamiento.<\/p>\r\n  <\/div>\r\n\r\n  <!-- 2. Monitoreo proactivo -->\r\n  <div class=\"sap-section-dark\">\r\n    <h3>Monitoreo proactivo<\/h3>\r\n    <p>La supervisi\u00f3n continua permite detectar posibles anomal\u00edas antes de que se conviertan en incidentes cr\u00edticos.<\/p>\r\n    <p>Este enfoque ayuda a anticiparse a problemas relacionados con capacidad, rendimiento o disponibilidad.<\/p>\r\n  <\/div>\r\n\r\n  <!-- 3. Soporte funcional SAP -->\r\n  <div class=\"sap-section-dark\">\r\n    <h3>Soporte funcional SAP<\/h3>\r\n    <p>Este servicio se enfoca en resolver incidencias relacionadas con los procesos de negocio ejecutados dentro de SAP.<\/p>\r\n    <p>Algunos de los m\u00f3dulos que suelen requerir soporte son:<\/p>\r\n    <ul>\r\n      <li>SAP FI\/CO.<\/li>\r\n      <li>SAP MM.<\/li>\r\n      <li>SAP SD.<\/li>\r\n      <li>SAP PP.<\/li>\r\n      <li>SAP EWM.<\/li>\r\n      <li>SAP HCM.<\/li>\r\n      <li>SAP SuccessFactors.<\/li>\r\n    <\/ul>\r\n  <\/div>\r\n\r\n  <!-- 4. Soporte t\u00e9cnico SAP BASIS -->\r\n  <div class=\"sap-section-dark\">\r\n    <h3>Soporte t\u00e9cnico SAP BASIS<\/h3>\r\n    <p>El soporte BASIS es esencial para garantizar el correcto funcionamiento de la infraestructura tecnol\u00f3gica que soporta SAP.<\/p>\r\n    <p>Entre sus responsabilidades destacan:<\/p>\r\n    <ul>\r\n      <li>Monitoreo del sistema.<\/li>\r\n      <li>Gesti\u00f3n de transportes.<\/li>\r\n      <li>Administraci\u00f3n de usuarios.<\/li>\r\n      <li>Configuraci\u00f3n de ambientes.<\/li>\r\n      <li>Aplicaci\u00f3n de parches.<\/li>\r\n      <li>Copias de seguridad.<\/li>\r\n      <li>Optimizaci\u00f3n del rendimiento.<\/li>\r\n    <\/ul>\r\n  <\/div>\r\n\r\n  <!-- 5. Gesti\u00f3n de incidentes cr\u00edticos -->\r\n  <div class=\"sap-section-dark\">\r\n    <h3>Gesti\u00f3n de incidentes cr\u00edticos<\/h3>\r\n    <p>Los incidentes deben clasificarse seg\u00fan su nivel de impacto para definir tiempos de atenci\u00f3n y resoluci\u00f3n acordes con las necesidades del negocio.<\/p>\r\n  <\/div>\r\n\r\n  <!-- 6. Gesti\u00f3n de cambios -->\r\n  <div class=\"sap-section-dark\">\r\n    <h3>Gesti\u00f3n de cambios<\/h3>\r\n    <p>Las organizaciones evolucionan constantemente. Por ello, el soporte SAP tambi\u00e9n debe contemplar ajustes y mejoras que permitan mantener alineada la plataforma con los objetivos estrat\u00e9gicos.<\/p>\r\n  <\/div>\r\n\r\n<\/div>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-3f1164f elementor-section-full_width elementor-section-height-min-height elementor-section-height-default elementor-section-items-middle\" data-id=\"3f1164f\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-wide\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-7851641\" data-id=\"7851641\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-e060f6d elementor-widget elementor-widget-text-editor\" data-id=\"e060f6d\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h2><b>Soporte SAP 24\/7 para SAP S\/4HANA<\/b><\/h2>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-59cddfd elementor-widget elementor-widget-html\" data-id=\"59cddfd\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<div class=\"sap-247\">\r\n  <style>\r\n    \/* Estilos base del contenedor *\/\r\n    .sap-247 {\r\n      font-size: 14px;\r\n      color: #000000;\r\n      line-height: 1.5;\r\n      max-width: 800px;\r\n      margin: 0 auto;\r\n    }\r\n    \r\n    .sap-247 p {\r\n      color: #000000;\r\n      margin: 0 0 1em 0;\r\n    }\r\n\r\n    \/* Lista personalizada aislada con bullets magenta *\/\r\n    .sap-247 ul {\r\n      margin: 1em 0 1em 0;\r\n      padding-left: 0 !important;\r\n      list-style: none !important;\r\n    }\r\n\r\n    .sap-247 ul li {\r\n      color: #000000;\r\n      font-weight: 600;\r\n      margin-bottom: 0.6em;\r\n      padding-left: 24px;\r\n      position: relative;\r\n      list-style-type: none !important;\r\n    }\r\n\
;600;700;800&display=swap\" rel=\"stylesheet\">\r\n<style>\r\n  .sap-grid-container {\r\n    font-family: 'Raleway', sans-serif;\r\n    font-size: 1em;\r\n    color: #FFFFFF;\r\n    line-height: 1.25; \/* Interlineado bien compacto *\/\r\n    \r\n    \/* Configuraci\u00f3n de la rejilla: 2 columnas *\/\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    column-gap: 30px; \/* Espacio horizontal entre las tarjetas *\/\r\n    row-gap: 30px;    \/* Espacio vertical entre las tarjetas *\/\r\n  }\r\n\r\n  \/* Estilos para cada tarjeta contenedora *\/\r\n  .sap-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    border: 2px solid #FFFFFF; \/* Borde blanco de 2px *\/\r\n    border-radius: 18px;       \/* Esquinas redondeadas suaves *\/\r\n    padding: 25px;             \/* Buen espacio interior para que no se amontone *\/\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .sap-grid-container h2 {\r\n    font-family: 'Raleway', sans-serif;\r\n    font-weight: 800;\r\n    font-size: 1.5em; \/* Ajuste sutil para balancear con el padding *\/\r\n    color: #FFFFFF;\r\n    border-left: 5px solid #AE2661;\r\n    padding-left: 12px;\r\n    margin-top: 0;\r\n    margin-bottom: 0.6em;\r\n  }\r\n\r\n  .sap-grid-container h3 {\r\n    font-family: 'Raleway', sans-serif;\r\n    font-weight: 700;\r\n    font-size: 1.15em;\r\n    color: #FFFFFF;\r\n    margin-top: 0.6em;\r\n    margin-bottom: 0.2em;\r\n    position: relative;\r\n    padding-left: 15px;\r\n  }\r\n\r\n  .sap-grid-container h3::before {\r\n    content: \"\";\r\n    position: absolute;\r\n    left: 0;\r\n    top: 0.3em;\r\n    width: 6px;\r\n    height: 6px;\r\n    background-color: #AE2661;\r\n    border-radius: 50%;\r\n  }\r\n\r\n  .sap-grid-container p {\r\n    color: #FFFFFF;\r\n    margin: 0.2em 0 0.6em 0;\r\n  }\r\n\r\n  .sap-grid-container p:last-child, \r\n  .sap-grid-container ul:last-child {\r\n    margin-bottom: 0; \/* Elimina margen innecesario al final del contenedor *\/\r\n  }
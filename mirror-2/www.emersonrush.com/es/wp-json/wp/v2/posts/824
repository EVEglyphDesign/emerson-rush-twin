\n    margin:0;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   TARJETA DESTACADA (FILA INFERIOR COMPLETA)\r\n   ========================================================= *\/\r\n\r\n.er-mejora-continua__card--featured{\r\n    grid-column: 1 \/ -1;\r\n    display:flex;\r\n    align-items:center;\r\n\r\n    background:var(--er-azul);\r\n    border-top-color:var(--er-naranja);\r\n\r\n    min-height:auto;\r\n    padding:28px 32px;\r\n}\r\n\r\n.er-mejora-continua__card--featured p{\r\n    color:var(--er-blanco);\r\n    font-size:16px;\r\n    line-height:1.65;\r\n    font-weight:500;\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   HOVER\r\n   ========================================================= *\/\r\n\r\n.er-mejora-continua__card:hover{\r\n    transform:translateY(-5px);\r\n\r\n    box-shadow:\r\n        0 16px 35px rgba(7,28,59,.10);\r\n}\r\n\r\n\r\n\/* =========================================================\r\n   RESPONSIVE: TABLET Y M\u00d3VIL\r\n   ========================================================= *\/\r\n\r\n@media(max-width:850px){\r\n\r\n    .er-mejora-continua{\r\n        padding:50px 0;\r\n    }\r\n\r\n    .er-mejora-continua__grid{\r\n        grid-template-columns:1fr;\r\n        gap:16px;\r\n    }\r\n\r\n    .er-mejora-continua__card{\r\n        grid-column:auto;\r\n        min-height:auto;\r\n    }\r\n\r\n}\r\n\r\n@media(max-width:600px){\r\n\r\n    .er-mejora-continua{\r\n        padding:40px 0;\r\n    }\r\n\r\n    .er-mejora-continua__header{\r\n        margin-bottom:30px;\r\n    }\r\n\r\n    .er-mejora-continua__header h2{\r\n        font-size:29px;\r\n    }\r\n\r\n    .er-mejora-continua__card{\r\n        padding:26px 24px;\r\n    }\r\n\r\n}\r\n\r\n<\/style>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-5f7721c elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle\" data-id=\"5f7721c\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-wide\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-76e26ab\" data-id=\"76e26ab\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-3bded52 elementor-widget elementor-widget-text-editor\" data-id=\"3bded52\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<h2 style=\"text-align: left;\"><b>Beneficios de implementar un plan de mantenimiento<\/b><\/h2>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-e6ed83c\" data-id=\"e6ed83c\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-58b7086 elementor-widget elementor-widget-text-editor\" data-id=\"58b7086\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Cuando la empresa establece un programa peri\u00f3dico de mantenimiento, los beneficios trascienden la estabilidad t\u00e9cnica del sistema.<\/span><\/p><p><span style=\"font-weight: 400;\">Entre los principales se encuentran:<\/span><\/p><ul><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Mayor disponibilidad de la plataforma.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Reducci\u00f3n de incidencias cr\u00edticas.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Mejor rendimiento de SAP S\/4HANA.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Informaci\u00f3n m\u00e1s confiable para la toma de decisiones.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Mayor seguridad de los datos.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Optimizaci\u00f3n continua de procesos.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Mejor experiencia para los usuarios.<\/span><\/li><li style=\"font-weight: 400;\" aria-level=\"1\"><span style=\"font-weight: 400;\">Mayor retorno de la inversi\u00f3n realizada en el ERP.<\/span><\/li><\/ul><p><span style=\"font-weight: 400;\">Estos beneficios permiten que SAP contin\u00fae siendo una plataforma capaz de responder a las necesidades actuales y futuras de la organizaci\u00f3n.<\/span><\/p>\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-7df9395 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"7df9395\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-f38b00f\" data-id=\"f38b00f\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-db47361 elementor-widget elementor-widget-image\" data-id=\"db47361\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t
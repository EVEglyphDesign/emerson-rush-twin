or-top-column elementor-element elementor-element-39b5e94\" data-id=\"39b5e94\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6db1e8c elementor-widget elementor-widget-html\" data-id=\"6db1e8c\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<!-- =========================================================\r\n     EMERSON RUSH \u00b7 CAPACIDAD PARA IMPULSAR LA MEJORA CONTINUA\r\n     ========================================================= -->\r\n\r\n<section class=\"er-beneficios-capacitacion\">\r\n\r\n    <div class=\"er-beneficios-capacitacion__header\">\r\n        <span class=\"er-beneficios-capacitacion__eyebrow\">\r\n            SOPORTE ESTRAT\u00c9GICO\r\n        <\/span>\r\n\r\n        <h2>\r\n            6. Capacidad para impulsar la\r\n            <span>mejora continua<\/span>\r\n        <\/h2>\r\n\r\n        <p>\r\n            El soporte moderno no debe enfocarse \u00fanicamente en corregir errores.\r\n        <\/p>\r\n    <\/div>\r\n\r\n\r\n    <div class=\"er-beneficios-capacitacion__grid\">\r\n\r\n        <!-- 01 -->\r\n        <article class=\"er-beneficios-capacitacion__card\">\r\n\r\n            <div class=\"er-beneficios-capacitacion__top\">\r\n                <span class=\"er-beneficios-capacitacion__number\">01<\/span>\r\n                <span class=\"er-beneficios-capacitacion__line\"><\/span>\r\n            <\/div>\r\n\r\n            <p class=\"er-beneficios-capacitacion__body-text\">\r\n                Un proveedor estrat\u00e9gico tambi\u00e9n ayuda a identificar oportunidades para optimizar procesos, mejorar el rendimiento del sistema y aprovechar nuevas funcionalidades disponibles en SAP.\r\n            <\/p>\r\n\r\n        <\/article>\r\n\r\n\r\n        <!-- 02 -->\r\n        <article class=\"er-beneficios-capacitacion__card\">\r\n\r\n            <di